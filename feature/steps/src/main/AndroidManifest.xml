<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Resume step tracking after a reboot if the user left it on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- Step counting runs as a short, user-started health foreground service. -->
        <service
            android:name=".data.service.StepCounterService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Handles the "Stop" action from the ongoing notification. -->
        <receiver
            android:name=".data.service.StepTrackingReceiver"
            android:exported="false" />

        <!-- Restarts tracking after boot / app update when it was on (no-op otherwise). -->
        <receiver
            android:name=".data.service.StepTrackingBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
