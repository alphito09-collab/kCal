rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Food catalogue + its version marker: read-only for the app, written by the seed script / admin.
    match /foods/{foodId} { allow read: if signedIn(); allow write: if false; }
    match /meta/{docId}   { allow read: if signedIn(); allow write: if false; }

    match /users/{uid} {
      // Only the push-token list may be written by the client.
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['fcmTokens', 'updatedAt']);

      // Entitlements are written exclusively by Cloud Functions (Admin SDK bypasses rules).
      match /entitlements/{id} { allow read: if isOwner(uid); allow write: if false; }
    }

    // Purchase-token → uid index kept by the functions for RTDN handling.
    match /purchases/{token} { allow read, write: if false; }
  }
}
